# For running locally (node server.js). On WebManager, set these on the app's Variables page instead.
# Never commit a real .env file: WebManager refuses to deploy a folder that contains one.

# Set by WebManager; for local runs only.
PORT=8080
HOST=0.0.0.0
DATA_DIR=./data
PUBLIC_URL=http://localhost:8080

# Cloudflare Access (required)
CF_ACCESS_TEAM_DOMAIN=myteam.cloudflareaccess.com
CF_ACCESS_AUD=
ALLOWED_EMAILS=you@example.com

# Signs OAuth tokens (required, 32+ characters): openssl rand -hex 32
HUB_SECRET=

# Optional
#OAUTH_REDIRECT_ALLOWLIST=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback
#MCP_ALLOW_LOOPBACK=false
#SITE_TITLE=Daily hub
